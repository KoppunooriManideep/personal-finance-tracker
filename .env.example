# Supabase project credentials.
# Copy this file to .env.local and fill in your values.
# The anon key is safe to expose in the client — data access is protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini key for the gold-bill reader (/api/parse-gold-receipt).
# SERVER-ONLY — no VITE_ prefix, so it is NEVER shipped to the browser. It's read
# by the dev middleware (vite.config) locally and by the Vercel function in prod.
# Get one free at https://aistudio.google.com/apikey. Optional GEMINI_MODEL
# overrides the default (gemini-2.5-flash).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
